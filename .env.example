# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# PostgreSQL is the primary database for production / Docker Compose:
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/skill_registry
# For local zero-dependency development/testing without docker:
# Example: sqlite+aiosqlite:///./skill_registry.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skill_registry

# Security & Isolation Configuration
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Audit Logging Configuration
AUDIT_LOG_ENABLED=true
